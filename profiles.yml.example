# Copy to profiles.yml (ignored by Git), then fill in your connection details.
# Set profile: "workshop" in dbt_project.yml, or rename this key to your choice.
workshop:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: ""   # Snowflake account identifier; omit https:// and domain suffix
      user: ""
      role: ""
      warehouse: ""
      database: ""  # OUTPUT database; input database is defined in sources.yml
      schema: ""    # Your own output schema, e.g. STAGING_MADOC
      threads: 4
      # Key-pair authentication works locally and in Codespaces.
      # The instructor must register your public key with your Snowflake user.
      private_key_path: ""  # Absolute path to your private key, stored outside Git
      # For an encrypted key, uncomment and set this environment variable:
      # private_key_passphrase: "{{ env_var('DBT_PRIVATE_KEY_PASSPHRASE') }}"
      # Alternatively, for local SSO: remove private_key_path and use:
      # authenticator: externalbrowser
